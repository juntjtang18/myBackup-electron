{
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.0.5",
    "jest": "^29.7.0"
  },
  "name": "myBackup",
  "version": "1.0.12",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "build": "./build.sh",
    "build:raw": "electron-builder",
    "verify:build": "node scripts/verify-build.js",
    "test": "jest"
  },
  "build": {
    "appId": "com.example.myBackup",
    "productName": "MyBackup",
    "files": [
      "src/**/*",
      "package.json",
      "mybackup-logging.properties",
      "!dist/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "MyBackup",
      "artifactName": "MyBackup-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juntjtang18/myBackup-electron.git"
  },
  "keywords": [
    "electron",
    "backup",
    "file-sync",
    "data-management"
  ],
  "author": "James Jun Tang",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/juntjtang18/myBackup-electron/issues"
  },
  "homepage": "https://github.com/juntjtang18/myBackup-electron#readme",
  "description": "myBackup",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "fs-extra": "^11.2.0"
  }
}
